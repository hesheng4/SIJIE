{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlanItem",
  "version": "1.0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_item_id", "description", "frozen_at", "expected_script_hash"],
  "properties": {
    "plan_item_id": {"type": "string", "pattern": "^pln_[a-f0-9]{12}$"},
    "description": {"type": "string"},
    "frozen_at": {"type": "string", "format": "date-time"},
    "expected_script_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "预注册时冻结的脚本 hash；绑定可机械判定，亦为 Auditor 重放比对对象之一"},
    "allowed_outputs": {"type": "array", "items": {"type": "string"}}
  }
}
