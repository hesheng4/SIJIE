{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExclusionList",
  "version": "1.0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_run_id", "generated_at", "rejected_claims", "tainted_executions",
               "phantom_events", "orphans", "vetoed_directions", "manifest_decision"],
  "properties": {
    "source_run_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "rejected_claims": {"type": "array", "items": {"type": "string", "pattern": "^clm_"}},
    "tainted_executions": {"type": "array", "items": {"type": "string", "pattern": "^exec_"}},
    "phantom_events": {"type": "array", "items": {"type": "string", "pattern": "^evt_"}},
    "orphans": {"type": "array", "items": {"type": "string", "pattern": "^clm_"}},
    "vetoed_directions": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "ref", "reason", "veto_by"],
      "properties": {
        "kind": {"enum": ["analysis", "citation"]},
        "ref": {"type": "string"},
        "reason": {"type": "string"},
        "veto_by": {"enum": ["hitl", "auditor"]}}}},
    "revival_permits": {"type": "array",
      "items": {"type": "string", "pattern": "^clm_[a-f0-9]{16}$"},
      "description": "1.0.2 新增：HITL 批准的复活谱系——这些 id 允许出现在新卡 derived_from（§1.5 复活三条件）；仍禁作证据"},
    "manifest_decision": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["reused"],
       "properties": {"reused": {"type": "string"}}},
      {"type": "object", "additionalProperties": false,
       "required": ["created", "reason", "triggered_by", "hitl_confirmed"],
       "properties": {
         "created": {"type": "string"},
         "reason": {"type": "string"},
         "triggered_by": {"enum": ["data_changed", "hitl", "auditor"]},
         "hitl_confirmed": {"type": "boolean", "const": true}}}]}
  }
}
